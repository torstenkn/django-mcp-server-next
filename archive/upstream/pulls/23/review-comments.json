tool_authentication_classes(),\n+            permission_classes=get_mcp_tool_permissions_classes(view_class),","path":"mcp_server/djangomcp.py","commit_id":"c9f9716c80f1195b8b874d24c9d19e09916141a9","original_commit_id":"1efd2fc28034873f773dee8c35a66e7e0f01b961","user":{"login":"omarbenhamid","id":1033063,"node_id":"MDQ6VXNlcjEwMzMwNjM=","avatar_url":"https://avatars.githubusercontent.com/u/1033063?v=4","gravatar_id":"","url":"https://api.github.com/users/omarbenhamid","html_url":"https://github.com/omarbenhamid","followers_url":"https://api.github.com/users/omarbenhamid/followers","following_url":"https://api.github.com/users/omarbenhamid/following{/other_user}","gists_url":"https://api.github.com/users/omarbenhamid/gists{/gist_id}","starred_url":"https://api.github.com/users/omarbenhamid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/omarbenhamid/subscriptions","organizations_url":"https://api.github.com/users/omarbenhamid/orgs","repos_url":"https://api.github.com/users/omarbenhamid/repos","events_url":"https://api.github.com/users/omarbenhamid/events{/privacy}","received_events_url":"https://api.github.com/users/omarbenhamid/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"MCP is just another protocol to access the same services, so the same permissions must apply. So it is better not to allow overriding permissions.\r\nIn special cases, user can still subclass the view class with a specific one and specific permissions, but the library shall not propose this as best practice.","created_at":"2025-06-25T08:19:09Z","updated_at":"2025-06-25T08:50:19Z","html_url":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166100902","pull_request_url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23","_links":{"self":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166100902"},"html":{"href":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166100902"},"pull_request":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23"}},"reactions":{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166100902/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":530,"side":"RIGHT","author_association":"COLLABORATOR","original_position":155,"position":1,"subject_type":"line","is_copilot_code_review":false,"copilot_code_review_sources":[]},{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166172171","pull_request_review_id":2957084981,"id":2166172171,"node_id":"PRRC_kwDOOns7hc6BHSoL","diff_hunk":"@@ -542,9 +593,17 @@ def __init__(self, mcp_server, view_class):\n         def raise_exception(exp):\n             raise exp\n \n+        kwargs = dict(\n+            filter_backends=[],\n+            authentication_classes=get_mcp_tool_authentication_classes(),","path":"mcp_server/djangomcp.py","commit_id":"c9f9716c80f1195b8b874d24c9d19e09916141a9","original_commit_id":"1efd2fc28034873f773dee8c35a66e7e0f01b961","user":{"login":"omarbenhamid","id":1033063,"node_id":"MDQ6VXNlcjEwMzMwNjM=","avatar_url":"https://avatars.githubusercontent.com/u/1033063?v=4","gravatar_id":"","url":"https://api.github.com/users/omarbenhamid","html_url":"https://github.com/omarbenhamid","followers_url":"https://api.github.com/users/omarbenhamid/followers","following_url":"https://api.github.com/users/omarbenhamid/following{/other_user}","gists_url":"https://api.github.com/users/omarbenhamid/gists{/gist_id}","starred_url":"https://api.github.com/users/omarbenhamid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/omarbenhamid/subscriptions","organizations_url":"https://api.github.com/users/omarbenhamid/orgs","repos_url":"https://api.github.com/users/omarbenhamid/repos","events_url":"https://api.github.com/users/omarbenhamid/events{/privacy}","received_events_url":"https://api.github.com/users/omarbenhamid/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"We should discuss more the authentication topic :\r\nThe DJANGO_MCP_AUTHENTICATION_CLASSES are enforced for all the calls of MCP in standard setup, that's because they are setup as auth/permission class of the `MCPStreamableHttpView` here https://github.com/omarbenhamid/django-mcp-server/blob/main/mcp_server/urls.py\r\n\r\nYou should not override it at this step. At this step we only disable the built-in authentication of DRF so that auth is not performed two times.\r\n\r\nYou can in advanced cases, as indicated in the README, mount the MCPStreamableHttpView in your urls.py directly with your own auth/permissions classes.\r\n\r\nWhat we could do, if it is useful for your use case, is an option like \"DJANGO_MCP_KEEP_DRF_AUTH_CLASSES\" that would mean you remove \"authentication_classes\" completely from you kwargs dict, to let the view or default DRF auth classes to apply.","created_at":"2025-06-25T08:47:13Z","updated_at":"2025-06-25T08:50:19Z","html_url":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166172171","pull_request_url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23","_links":{"self":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166172171"},"html":{"href":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166172171"},"pull_request":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23"}},"reactions":{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166172171/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":598,"side":"RIGHT","author_association":"COLLABORATOR","original_position":213,"position":1,"subject_type":"line","is_copilot_code_review":false,"copilot_code_review_sources":[]},{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166190202","pull_request_review_id":2957290767,"id":2166190202,"node_id":"PRRC_kwDOOns7hc6BHXB6","diff_hunk":"@@ -483,16 +516,26 @@ def __call__(self, body: dict):\n \n \n class _DRFListAPIViewCallerTool:\n-    def __init__(self, mcp_server, view_class):\n+    def __init__(self, mcp_server, view_class, actions=None):\n         if not issubclass(view_class, ListModelMixin):\n             raise ValueError(f\"{view_class} must be a subclass of DRF ListModelMixin\")\n         self.mcp_server = mcp_server\n         self.view_class = view_class\n         def raise_exception(exp):\n             raise exp\n+\n+        kwargs = dict(\n+            filter_backends=[],\n+            authentication_classes=get_mcp_tool_authentication_classes(),\n+            permission_classes=get_mcp_tool_permissions_classes(view_class),","path":"mcp_server/djangomcp.py","commit_id":"c9f9716c80f1195b8b874d24c9d19e09916141a9","original_commit_id":"1efd2fc28034873f773dee8c35a66e7e0f01b961","user":{"login":"Artui","id":15174053,"node_id":"MDQ6VXNlcjE1MTc0MDUz","avatar_url":"https://avatars.githubusercontent.com/u/15174053?v=4","gravatar_id":"","url":"https://api.github.com/users/Artui","html_url":"https://github.com/Artui","followers_url":"https://api.github.com/users/Artui/followers","following_url":"https://api.github.com/users/Artui/following{/other_user}","gists_url":"https://api.github.com/users/Artui/gists{/gist_id}","starred_url":"https://api.github.com/users/Artui/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artui/subscriptions","organizations_url":"https://api.github.com/users/Artui/orgs","repos_url":"https://api.github.com/users/Artui/repos","events_url":"https://api.github.com/users/Artui/events{/privacy}","received_events_url":"https://api.github.com/users/Artui/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"In that case it should always preserve existing permission classes. Because, currently, it's overriding the view to remove permission classes completely. I will remove the new variable and this method, and will use default permission classes in that case.","created_at":"2025-06-25T08:54:18Z","updated_at":"2025-06-25T08:54:18Z","html_url":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166190202","pull_request_url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23","_links":{"self":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166190202"},"html":{"href":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166190202"},"pull_request":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23"}},"reactions":{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166190202/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":530,"side":"RIGHT","in_reply_to_id":2166100902,"author_association":"CONTRIBUTOR","original_position":155,"position":1,"subject_type":"line","is_copilot_code_review":false,"copilot_code_review_sources":[]},{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166197888","pull_request_review_id":2957302976,"id":2166197888,"node_id":"PRRC_kwDOOns7hc6BHY6A","diff_hunk":"@@ -245,10 +245,33 @@ drf_publish_update_mcp_tool(MyDRFAPIView, instructions=\"Use this tool to update\n ```\n \n \n-**IMPORTANT** Notice that **builti-in authentication classes are disabled** along with filter_backends, that's because\n-the MCP authentication is used. \n+**IMPORTANT** \n \n+Notice that **builti-in authentication classes are disabled** by default along with filter_backends, permission_classes and pagination_class, that's because\n+the MCP authentication is used. If you want to use your original authentication classes, set `DJANGO_MCP_AUTHENTICATION_CLASSES` in settings to `True`. \n \n+You can also set `DJANGO_MCP_USE_TOOL_PERMISSION_CLASSES` to `True` if you want to maintain your permissions.\n+\n+Since the pagination_class is also disabled, you will need to account for that if you're using an existing paginated DRF view (`self.paginator` will be `None`).\n+\n+\n+\n+### Django Rest Framework Request handling\n+\n+The library uses its own wrapped request object. If you have additional fields from the original DRF request that need to be copied\n+over to the MCP request - do so via `DJANGO_MCP_REQUEST_POSTPROCESSING_HOOKS` setting in django settings:\n+\n+```python \n+def bird_counter_request_hook(mcp_request, drf_request):\n+    mcp_request.original_request_field = getattr(drf_request, \"original_request_field\", None)\n+\n+```\n+\n+```python\n+DJANGO_MCP_REQUEST_POSTPROCESSING_HOOKS = [","path":"README.md","commit_id":"c9f9716c80f1195b8b874d24c9d19e09916141a9","original_commit_id":"1efd2fc28034873f773dee8c35a66e7e0f01b961","user":{"login":"Artui","id":15174053,"node_id":"MDQ6VXNlcjE1MTc0MDUz","avatar_url":"https://avatars.githubusercontent.com/u/15174053?v=4","gravatar_id":"","url":"https://api.github.com/users/Artui","html_url":"https://github.com/Artui","followers_url":"https://api.github.com/users/Artui/followers","following_url":"https://api.github.com/users/Artui/following{/other_user}","gists_url":"https://api.github.com/users/Artui/gists{/gist_id}","starred_url":"https://api.github.com/users/Artui/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artui/subscriptions","organizations_url":"https://api.github.com/users/Artui/orgs","repos_url":"https://api.github.com/users/Artui/repos","events_url":"https://api.github.com/users/Artui/events{/privacy}","received_events_url":"https://api.github.com/users/Artui/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Sure - but Django middleware is not enough here. Or rather - it works just fine, but is completely disregarded. In this piece of code particularly\r\n<img width=\"864\" alt=\"image\" src=\"https://github.com/user-attachments/assets/f1b2e0cd-be90-4b53-a1c5-542aa5377cb2\" />\r\nonly `user` and `session` is copied from the DRF request into the MCP request. In our case, for example, we have eagerly loaded permissions (based on the context of request) and also some additional entity-specific data. Those are set on request via Django middleware - but those fields are lost when processing the request via _DRFRequestWrapper, because they are not copied properly. \r\nI don't think a decorator will work here - because _DRFRequestWrapper is so \"internal\" here","created_at":"2025-06-25T08:58:01Z","updated_at":"2025-06-25T09:55:55Z","html_url":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166197888","pull_request_url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23","_links":{"self":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166197888"},"html":{"href":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166197888"},"pull_request":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23"}},"reactions":{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166197888/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":271,"side":"RIGHT","in_reply_to_id":2166080362,"author_association":"CONTRIBUTOR","original_position":29,"position":1,"subject_type":"line","is_copilot_code_review":false,"copilot_code_review_sources":[]},{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166238952","pull_request_review_id":2957370897,"id":2166238952,"node_id":"PRRC_kwDOOns7hc6BHi7o","diff_hunk":"@@ -542,9 +593,17 @@ def __init__(self, mcp_server, view_class):\n         def raise_exception(exp):\n             raise exp\n \n+        kwargs = dict(\n+            filter_backends=[],\n+            authentication_classes=get_mcp_tool_authentication_classes(),","path":"mcp_server/djangomcp.py","commit_id":"c9f9716c80f1195b8b874d24c9d19e09916141a9","original_commit_id":"1efd2fc28034873f773dee8c35a66e7e0f01b961","user":{"login":"Artui","id":15174053,"node_id":"MDQ6VXNlcjE1MTc0MDUz","avatar_url":"https://avatars.githubusercontent.com/u/15174053?v=4","gravatar_id":"","url":"https://api.github.com/users/Artui","html_url":"https://github.com/Artui","followers_url":"https://api.github.com/users/Artui/followers","following_url":"https://api.github.com/users/Artui/following{/other_user}","gists_url":"https://api.github.com/users/Artui/gists{/gist_id}","starred_url":"https://api.github.com/users/Artui/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artui/subscriptions","organizations_url":"https://api.github.com/users/Artui/orgs","repos_url":"https://api.github.com/users/Artui/repos","events_url":"https://api.github.com/users/Artui/events{/privacy}","received_events_url":"https://api.github.com/users/Artui/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I guess the library doesn't work correctly with DRF. \r\n`return self.view(request).data` - this statement is present in all tool wrappers. And while you're passing `request` into the view, you're omitting the fact that `dispatch` is called on when you do a `.data` call\r\n<img width=\"695\" alt=\"image\" src=\"https://github.com/user-attachments/assets/c50314d9-f8b9-4998-8ec3-4a1940ce9035\" />\r\nDispatch wraps the request you passed on in another request\r\n<img width=\"624\" alt=\"image\" src=\"https://github.com/user-attachments/assets/cace307b-5fe4-4e42-9de2-f8744dda44a2\" />\r\nwhich is `rest_framework.request.Request` instance\r\nWhich, in turn, doesn't use `WSGIRequest` user instance, but tries to authenticate one more time\r\n<img width=\"787\" alt=\"image\" src=\"https://github.com/user-attachments/assets/daa1330d-7270-4ef3-a52c-01b091249b13\" />\r\nWhich works off of authentication_classes\r\n\r\nSo, in summary - while the global MCP authentication classes work for the purpose of not allowing unauthenticated users to access the server as a whole, when integrating with DRF views, a whole lot of context goes missing if auth classes are omitted from the view","created_at":"2025-06-25T09:17:56Z","updated_at":"2025-06-25T09:17:56Z","html_url":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166238952","pull_request_url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23","_links":{"self":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166238952"},"html":{"href":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166238952"},"pull_request":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23"}},"reactions":{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166238952/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":598,"side":"RIGHT","in_reply_to_id":2166172171,"author_association":"CONTRIBUTOR","original_position":213,"position":1,"subject_type":"line","is_copilot_code_review":false,"copilot_code_review_sources":[]},{"url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166288556","pull_request_review_id":2957452605,"id":2166288556,"node_id":"PRRC_kwDOOns7hc6BHvCs","diff_hunk":"@@ -542,9 +593,17 @@ def __init__(self, mcp_server, view_class):\n         def raise_exception(exp):\n             raise exp\n \n+        kwargs = dict(\n+            filter_backends=[],\n+            authentication_classes=get_mcp_tool_authentication_classes(),","path":"mcp_server/djangomcp.py","commit_id":"c9f9716c80f1195b8b874d24c9d19e09916141a9","original_commit_id":"1efd2fc28034873f773dee8c35a66e7e0f01b961","user":{"login":"Artui","id":15174053,"node_id":"MDQ6VXNlcjE1MTc0MDUz","avatar_url":"https://avatars.githubusercontent.com/u/15174053?v=4","gravatar_id":"","url":"https://api.github.com/users/Artui","html_url":"https://github.com/Artui","followers_url":"https://api.github.com/users/Artui/followers","following_url":"https://api.github.com/users/Artui/following{/other_user}","gists_url":"https://api.github.com/users/Artui/gists{/gist_id}","starred_url":"https://api.github.com/users/Artui/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Artui/subscriptions","organizations_url":"https://api.github.com/users/Artui/orgs","repos_url":"https://api.github.com/users/Artui/repos","events_url":"https://api.github.com/users/Artui/events{/privacy}","received_events_url":"https://api.github.com/users/Artui/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Basically, main issue is that the library tries to bootstrap an internal DRF view call without respecting the request processing flow that DRF has. When you're doing `return self.view(request).data`, you're basically \"starting fresh\" from DRF point of view in terms of user instance being there on the DRF request object that is actually re-created down the line.","created_at":"2025-06-25T09:40:19Z","updated_at":"2025-06-25T09:40:19Z","html_url":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166288556","pull_request_url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23","_links":{"self":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/comments/2166288556"},"html":{"href":"https://github.com/gts360/django-mcp-server/pull/23#discussion_r2166288556"},"pull_request":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/23"}},"reactions":{"url":"https://api.git