Date: Thu, 26 Jun 2025 15:40:52 +0200
Subject: [PATCH 14/15] Cleanup

---
 mcp_server/djangomcp.py | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/mcp_server/djangomcp.py b/mcp_server/djangomcp.py
index 8def456..6ab29f6 100644
--- a/mcp_server/djangomcp.py
+++ b/mcp_server/djangomcp.py
@@ -448,12 +448,6 @@ def __init__(self, mcp_server, mcp_request, method, body_json=None, id=None):
         self.path = f'/_djangomcpserver/{mcp_server.name}'
         if id:
             self.path += f"/{id}"
-        request_wrapper_postprocessing_hooks = [
-            import_string(cls)
-            for cls in getattr(settings, "DJANGO_MCP_REQUEST_POSTPROCESSING_HOOKS", [])
-        ]
-        for hook in request_wrapper_postprocessing_hooks:
-            hook(self, mcp_request)
 
 
 class _DRFCreateAPIViewCallerTool:

From c9f9716c80f1195b8b874d24c9d19e09916141a9 Mon Sep 17 00:00:00 2001
From: Artur Veres <artur8118@gmail.com>
Date: Thu, 26 Jun 2025 15:42:25 +0200
Subject: [PATCH 15/15] Cleanup

---
 mcp_server/djangomcp.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/mcp_server/djangomcp.py b/mcp_server/djangomcp.py
index 6ab29f6..2eae31a 100644
--- a/mcp_server/djangomcp.py
+++ b/mcp_server/djangomcp.py
@@ -237,6 +237,7 @@ def register_drf_create_tool(self, view_class: type("GenericAPIView"), name=None
         :param name: the tool name, can be auto gnerated
         :param instructions: the instructions to provide to the MCP client, mandatory if the view does not have a docstring.
         :param body_schema: JSON Schema, optional in reasonably rescent DRF that support schema generation. If DRF does not support schema geneation this becomes mandatory
+        :param actions: DRF action mapping for ViewSet initialization. Omit if the class that is added is not a ViewSet subclass. Example: {'post': 'create'}
         :return:
         """
         assert instructions or view_class.__doc__, "You need to provide instructions or the class must have a docstring"
@@ -292,6 +293,7 @@ def register_drf_update_tool(self, view_class: type("GenericAPIView"), name=None
         :param name: the tool name, can be auto gnerated
         :param instructions: the instructions to provide to the MCP client, mandatory if the view does not have a docstring.
         :param body_schema: JSON Schema, optional in reasonably rescent DRF that support schema generation. If DRF does not support schema geneation this becomes mandatory
+        :param actions: DRF action mapping for ViewSet initialization. Omit if the class that is added is not a ViewSet subclass. Example: {'put': 'update'}
         :return:
         """
         assert instructions or view_class.__doc__, "You need to provide instructions or the class must have a docstring"
