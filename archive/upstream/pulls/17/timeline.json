, in dispatch\n    response = self.handle_exception(exc)\n  File \"/home/control/env_313/lib/python3.13/site-packages/rest_framework/views.py\", line 469, in handle_exception\n    self.raise_uncaught_exception(exc)\n    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~^^^^^\n  File \"/home/control/env_313/lib/python3.13/site-packages/rest_framework/views.py\", line 480, in raise_uncaught_exception\n    raise exc\n  File \"/home/control/env_313/lib/python3.13/site-packages/rest_framework/views.py\", line 506, in dispatch\n    response = handler(request, *args, **kwargs)\n  File \"/home/control/env_313/lib/python3.13/site-packages/mcp_server/views.py\", line 18, in get\n    return self.mcp_server.handle_django_request(request)\n           ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~^^^^^^^^^\n  File \"/home/control/env_313/lib/python3.13/site-packages/mcp_server/djangomcp.py\", line 207, in handle_django_request\n    delattr(request, 'session')\n    ~~~~~~~^^^^^^^^^^^^^^^^^^^^\nAttributeError: 'Request' object has no attribute 'session'\n\n```","reactions":{"url":"https://api.github.com/repos/gts360/django-mcp-server/issues/9/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/gts360/django-mcp-server/issues/9/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}},"event":"cross-referenced"},{"id":2896803261,"node_id":"PRR_kwDOOns7hc6sqbW9","user":{"login":"omarbenhamid","id":1033063,"node_id":"MDQ6VXNlcjEwMzMwNjM=","avatar_url":"https://avatars.githubusercontent.com/u/1033063?v=4","gravatar_id":"","url":"https://api.github.com/users/omarbenhamid","html_url":"https://github.com/omarbenhamid","followers_url":"https://api.github.com/users/omarbenhamid/followers","following_url":"https://api.github.com/users/omarbenhamid/following{/other_user}","gists_url":"https://api.github.com/users/omarbenhamid/gists{/gist_id}","starred_url":"https://api.github.com/users/omar