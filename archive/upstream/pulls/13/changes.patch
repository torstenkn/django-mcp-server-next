From 2beecdfa93125fed904c7ebada26f0eea83dbfae Mon Sep 17 00:00:00 2001
From: Lysi <dominik.lysiak@freenet.de>
Date: Thu, 29 May 2025 18:34:09 +0100
Subject: [PATCH 1/2] Fixed: Autodiscovery MCPToolset bug

---
 mcp_server/djangomcp.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/mcp_server/djangomcp.py b/mcp_server/djangomcp.py
index 33bfc71..8492def 100644
--- a/mcp_server/djangomcp.py
+++ b/mcp_server/djangomcp.py
@@ -343,7 +343,9 @@ def __init__(cls, name, bases, namespace):
         global mqs_dep_warned
         super().__init__(name, bases, namespace)
         # Skip base class itself
-        if name == "MCPToolset":
+        if name != "MCPToolset" and (
+            bases and MCPToolset in bases or any(issubclass(base, MCPToolset) for base in bases if isinstance(base, type))
+        ):
             ToolsetMeta.registry[name] = cls
 
     @staticmethod

