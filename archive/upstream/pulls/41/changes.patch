From 7427fb01b440a0da5abb2daaaacb72959f751c26 Mon Sep 17 00:00:00 2001
From: Omar BENHAMID <omar.benhamid@smart-gts.com>
Date: Sun, 6 Jul 2025 20:54:17 +0200
Subject: [PATCH 1/3] mcp_inspect: improved to work on all plateforms without
 external process

---
 README.md                                     |  8 +++++
 mcp_server/management/commands/mcp_inspect.py | 35 +++++++++++++------
 2 files changed, 33 insertions(+), 10 deletions(-)

diff --git a/README.md b/README.md
index 47a5350..e885580 100644
--- a/README.md
+++ b/README.md
@@ -124,6 +124,14 @@ class MyAITools(MCPToolset):
 
 ---
 
+### Verify with MCP Inspect
+
+Use the management commande mcp_inspect to ensure your tools are correctly declared : 
+
+```bash
+python manage.py mcp_inspect
+```
+
 ### Use the MCP with any MCP Client
 
 The mcp tool is now published on your Django App at `/mcp` endpoint. 
diff --git a/mcp_server/management/commands/mcp_inspect.py b/mcp_server/management/commands/mcp_inspect.py
index b9a8472..31ce032 100644
--- a/mcp_server/management/commands/mcp_inspect.py
+++ b/mcp_server/management/commands/mcp_inspect.py
@@ -1,19 +1,30 @@
+import asyncio
+import os
+from io import TextIOWrapper
+
 from django.core.management.base import BaseCommand
 from asgiref.sync import async_to_sync
-from mcp import ClientSession, StdioServerParameters
+import anyio
+from mcp import ClientSession, StdioServerParameters, stdio_server
 from mcp.client.stdio import stdio_client
 
+from mcp_server import mcp_server
+
 
 async def _check_client():
-    server_params = StdioServerParameters(
-        command="python",
-        args=[
-            "manage.py",
-            "stdio_server"
-        ]
-    )
-    async with stdio_client(server_params) as (read, write):
-        async with ClientSession(read, write) as session:
+
+    cl_wr, svr_rd = anyio.create_memory_object_stream(0)
+    svr_wr, cl_rd = anyio.create_memory_object_stream(0)
+
+    async def run_server():
+        await mcp_server._mcp_server.run(
+            svr_rd,
+            svr_wr,
+            mcp_server._mcp_server.create_initialization_options(),
+        )
+
+    async def run_client():
+        async with ClientSession(cl_rd, cl_wr) as session:
             await session.initialize()
 
             print("Tools discovered in server:")
@@ -31,6 +42,10 @@ async def _check_client():
             for prompt in prompt_list.prompts:
                 print(f'\t{prompt.name}: {prompt.description}')
 
+    async with anyio.create_task_group() as tg:
+        tg.start_soon(run_server)
+        tg.start_soon(run_client)
+
 
 _check_client_sync = async_to_sync(_check_client)
 

