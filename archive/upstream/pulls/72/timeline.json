[[{"sha":"e12b463c2932d5abe8405cc38bb88f03ab04a8c2","node_id":"C_kwDOOns7hdoAKGUxMmI0NjNjMjkzMmQ1YWJlODQwNWNjMzhiYjg4ZjAzYWIwNGE4YzI","url":"https://api.github.com/repos/gts360/django-mcp-server/git/commits/e12b463c2932d5abe8405cc38bb88f03ab04a8c2","html_url":"https://github.com/gts360/django-mcp-server/commit/e12b463c2932d5abe8405cc38bb88f03ab04a8c2","author":{"name":"Kaya Emre Arikan","email":"kearikan1@gmail.com","date":"2026-09-12T15:06:28Z"},"committer":{"name":"Kaya Emre Arikan","email":"kearikan1@gmail.com","date":"2026-09-12T15:06:28Z"},"tree":{"sha":"ad8fce51b22da5982393371a30844b2297c2ef2d","url":"https://api.github.com/repos/gts360/django-mcp-server/git/trees/ad8fce51b22da5982393371a30844b2297c2ef2d"},"message":"security: validate $match/$project field paths against allowed_models/exclude_fields\n\n_parse_match() and _interpret_projection() built their field paths straight\nfrom caller input and passed them to Q()/values() with no check against\nget_published_models() or get_excluded_fields() - both of those allowlists\nwere only ever consulted for $lookup and for building the advertised schema,\nnever at query execution time.\n\nSince the whole left-hand side of a $match key is caller-controlled, this\nalso let a Django lookup/transform be smuggled in via the field name itself\n(e.g. author__password__startswith), bypassing the $-operator allowlist a\nfew lines above it.\n\nNet effect: an MCP client that can query one published model can traverse\nany FK/M2M/reverse relation from it - including into models that were never\nregistered with a ModelQueryToolset at all - and use equality/startswith/\nregex filters as a character-level read oracle over any field it finds,\nincluding fields explicitly listed in exclude_fields. Publishing a single\nmodel whose rows relate (even transitively) to auth.User is enough to read\nout password hashes one character at a time.\n\nThis adds _validate_field_path(), mirroring the existing _validate_lookup()/\n_resolve_model_from_path() logic already used for $lookup: walk the\n'__'-separated path hop by hop, require each hop to be a real field, refuse\na relation hop into an unpublished model, and refuse any hop that is an\nexcluded field. It's threaded through _parse_match (including its $and/$or/\n$nor recursion) and _interpret_projection, since $project turned out to have\nthe identical gap. The no-$project default output path now also builds its\nfield list from the model's concrete fields minus excluded_fields, so\nexclude_fields actually keeps a field out of the response and not only out\nof the schema shown to the model.\n\nVerified against a PoC (one published Article model, unpublished auth.User):\nthe intended query is unaffected, internal_note/author_id no longer appear\nin the default response body, and every traversal/exclusion/operator-in-\nfield-name attempt is now rejected with a clear ValueError.\n\nReported privately to the maintainer; this PR accompanies that report.","parents":[{"sha":"0599c7d45a242519b6bdb63775bd07228c5f70d6","url":"https://api.github.com/repos/gts360/django-mcp-server/git/commits/0599c7d45a242519b6bdb63775bd07228c5f70d6","html_url":"https://github.com/gts360/django-mcp-server/commit/0599c7d45a242519b6bdb63775bd07228c5f70d6"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":5187083771,"node_id":"PRR_kwDOOns7hc8AAAABNSyd-w","user":{"login":"omarbenhamid","id":1033063,"node_id":"MDQ6VXNlcjEwMzMwNjM=","avatar_url":"https://avatars.githubusercontent.com/u/1033063?v=4","gravatar_id":"","url":"https://api.github.com/users/omarbenhamid","html_url":"https://github.com/omarbenhamid","followers_url":"https://api.github.com/users/omarbenhamid/followers","following_url":"https://api.github.com/users/omarbenhamid/following{/other_user}","gists_url":"https://api.github.com/users/omarbenhamid/gists{/gist_id}","starred_url":"https://api.github.com/users/omarbenhamid/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/omarbenhamid/subscriptions","organizations_url":"https://api.github.com/users/omarbenhamid/orgs","repos_url":"https://api.github.com/users/omarbenhamid/repos","events_url":"https://api.github.com/users/omarbenhamid/events{/privacy}","received_events_url":"https://api.github.com/users/omarbenhamid/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"e12b463c2932d5abe8405cc38bb88f03ab04a8c2","state":"commented","html_url":"https://github.com/gts360/django-mcp-server/pull/72#pullrequestreview-5187083771","pull_request_url":"https://api.github.com/repos/gts360/django-mcp-server/pulls/72","_links":{"html":{"href":"https://github.com/gts360/django-mcp-server/pull/72#pullrequestreview-5187083771"},"pull_request":{"href":"https://api.github.com/repos/gts360/django-mcp-server/pulls/72"}},"submitted_at":"2026-09-12T16:40:04Z","updated_at":"2026-09-12T16:40:04Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"800c16d4815c9ed80bf0481268b45e879162d599","node_id":"C_kwDOOns7hdoAKDgwMGMxNmQ0ODE1YzllZDgwYmYwNDgxMjY4YjQ1ZTg3OTE2MmQ1OTk","url":"https://api.github.com/repos/gts360/django-mcp-server/git/commits/800c16d4815c9ed80bf0481268b45e879162d599","html_url":"https://github.com/gts360/django-mcp-server/commit/800c16d4815c9ed80bf0481268b45e879162d599","author":{"name":"Kaya Emre Arikan","email":"kearikan1@gmail.com","date":"2026-09-27T13:58:52Z"},"committer":{"name":"Kaya Emre Arikan","email":"kearikan1@gmail.com","date":"2026-09-27T13:58:52Z"},"tree":{"sha":"2e9e8fdf5cf0a9faa51b77beaed78b1bb589d0fb","url":"https://api.github.com/repos/gts360/django-mcp-server/git/trees/2e9e8fdf5cf0a9faa51b77beaed78b1bb589d0fb"},"message":"Resolve exclude_fields per related model and reject unresolved lookup segments\n\nAddresses review feedback on the field-path validation added in the\nprevious commit:\n\n- excluded_fields is now re-resolved at each hop via query_tool_models,\n  so a related model's own exclude_fields is honoured once the path\n  traverses into it, not just the root model's. A related model that\n  passes the allowed_models check but has no registered toolset fails\n  closed instead of being treated as having no exclusions.\n\n- A path segment that does not resolve to a real model field (a Django\n  lookup/transform such as __startswith or __year smuggled into the bare\n  key) is now rejected outright instead of silently returning, which\n  previously let any lookup bypass the $-operator allowlist on any\n  already-published field.\n\nVerified against a local project with two published, related toolsets\n(one declaring its own exclude_fields): the related-model exclusion and\nthe lookup-suffix rejection are both enforced, while legitimate\ntraversal into non-excluded related fields and the $regex/extended\noperator mechanisms are unaffected.","parents":[{"sha":"e12b463c2932d5abe8405cc38bb88f03ab04a8c2","url":"https://api.github.com/repos/gts360/django-mcp-server/git/commits/e12b463c2932d5abe8405cc38bb88f03ab04a8c2","html_url":"https://github.com/gts360/django-mcp-server/commit/e12b463c2932d5abe8405cc38bb88f03ab04a8c2"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"actor":{"login":"frutik","id":743770,"node_id":"MDQ6VXNlcjc0Mzc3MA==","avatar_url":"https://avatars.githubusercontent.com/u/743770?v=4","gravatar_id":"","url":"https://api.github.com/users/frutik","html_url":"https://github.com/frutik","followers_url":"https://api.github.com/users/frutik/followers","following_url":"https://api.github.com/users/frutik/following{/other_user}","gists_url":"https://api.github.com/users/frutik/gists{/gist_id}","starred_url":"https://api.github.com/users/frutik/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/frutik/subscriptions","organizations_url":"https://api.github.com/users/frutik/orgs","repos_url":"https://api.github.