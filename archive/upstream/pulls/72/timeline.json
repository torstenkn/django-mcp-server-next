odel and of any model reachable through `belongs_to`, including unpublished ones. This is the same gap upstream reports in gts360/django-mcp-server#72; `:fixed` (the default) closes it.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)","reactions":{"url":"https://api.github.com/repos/frutik/ror-mcp-server/issues/23/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/frutik/ror-mcp-server/issues/23/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":35452219115,"node_id":"CE_lADOOns7hc8AAAABQ-Xri88AAAAIQR3u6w","url":"https://api.github.com/repos/gts360/django-mcp-server/issues/events/35452219115","actor":{"login":"kemrec","id":25618690,"node_id":"MDQ6VXNlcjI1NjE4Njkw","avatar_url":"https://avatars.githubusercontent.com/u/25618690?v=4","gravatar_id":"","url":"https://api.github.com/users/kemrec","html_url":"https://github.com/kemrec","followers_url":"https://api.github.com/users/kemrec/followers","following_url":"https://api.github.com/users/kemrec/following{/other_user}","gists_url":"https://api.github.com/users/kemrec/gists{/gist_id}","starred_url":"https://api.github.com/users/kemrec/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kemrec/subscriptions","organizations_url":"https://api.github.com/users/kemrec/orgs","repos_url":"https://api.github.com/users/kemrec/repos","events_url":"https://api.github.com/users/kemrec/events{/privacy}","received_events_url":"https://api.github.com/users/kemrec/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2026-11-07T18:26:01Z","state_reason":null,"intent":null,"performed_via_github_app":null}]]