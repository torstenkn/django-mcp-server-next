[[{"sha":"605181a7278c3272d9b7782bc5761453094ac396","node_id":"C_kwDOR3bRLNoAKDYwNTE4MWE3Mjc4YzMyNzJkOWI3NzgyYmM1NzYxNDUzMDk0YWMzOTY","commit":{"author":{"name":"Harry Dessieu","email":"harrydess@gmail.com","date":"2026-04-02T00:22:41Z"},"committer":{"name":"Harry Dessieu","email":"harrydess@gmail.com","date":"2026-04-02T00:22:41Z"},"message":"feat: add register_drf_filter_tool for django-filter integration\n\nExpose DRF ViewSet filter parameters as typed MCP tool inputs.\n\nWhen a ViewSet has a `filterset_class` or `filterset_fields`,\n`register_drf_filter_tool` reads every declared django-filter\nfield and registers it as an optional, typed tool parameter.\nA `limit` parameter caps the result set.\n\n- New module `mcp_server/drf_filter.py` with all filter logic\n  (helpers, _DRFFilterCallerTool, register_drf_filter_tool)\n- Thin `DjangoMCP.register_drf_filter_tool()` method delegates\n  to the new module\n- `drf_publish_filter_mcp_tool` decorator follows existing\n  publish pattern\n- django-filter is an optional dependency; ImportError raised\n  only when register_drf_filter_tool is called without it\n\nCloses #62","tree":{"sha":"ea63f93b5fc594ac0bae6cf33a2fe9104df94f6e","url":"https://api.github.com/repos/gts360/django-mcp-server/git/trees/ea63f93b5fc594ac0bae6cf33a2fe9104df94f6e"},"url":"https://api.github.com/repos/gts360/django-mcp-server/git/commits/605181a7278c3272d9b7782bc5761453094ac396","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/gts360/django-mcp-server/commits/605181a7278c3272d9b7782bc5761453094ac396","html_url":"https://github.com/gts360/django-mcp-server/commit/605181a7278c3272d9b7782bc5761453094ac396","comments_url":"https://api.github.com/repos/gts360/django-mcp-server/commits/605181a7278c3272d9b7782bc5761453094ac396/comments","author":{"login":"harryd31","id":6937848,"node_id":"MDQ6VXNlcjY5Mzc4NDg=","avatar_url":"https://avatars.gith