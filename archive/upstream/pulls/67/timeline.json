[[{"sha":"497c1766c2cf69e6203d11d7929e172ae73ea88d","node_id":"C_kwDOOns7hdoAKDQ5N2MxNzY2YzJjZjY5ZTYyMDNkMTFkNzkyOWUxNzJhZTczZWE4OGQ","url":"https://api.github.com/repos/gts360/django-mcp-server/git/commits/497c1766c2cf69e6203d11d7929e172ae73ea88d","html_url":"https://github.com/gts360/django-mcp-server/commit/497c1766c2cf69e6203d11d7929e172ae73ea88d","author":{"name":"gghez","email":"6266247+gghez@users.noreply.github.com","date":"2026-04-24T20:53:26Z"},"committer":{"name":"gghez","email":"6266247+gghez@users.noreply.github.com","date":"2026-04-24T21:10:40Z"},"tree":{"sha":"85f2419b62ea5e178d00ccde909bb6019deb2c3c","url":"https://api.github.com/repos/gts360/django-mcp-server/git/trees/85f2419b62ea5e178d00ccde909bb6019deb2c3c"},"message":"feat: forward icons parameter to FastMCP (closes #58)\n\nDjangoMCP.__init__ now accepts an optional `icons` list and forwards\nit to FastMCP.__init__, so MCP clients (e.g. Claude Desktop) can\ndisplay a server icon. The option is also usable via\nDJANGO_MCP_GLOBAL_SERVER_CONFIG.\n\nThe `icons` keyword was introduced in mcp 1.15.0, so the lower bound\non the `mcp` dependency is bumped from 1.8.0 to 1.15.0.","parents":[{"sha":"0599c7d45a242519b6bdb63775bd07228c5f70d6","url":"https://api.github.com/repos/gts360/django-mcp-server/git/commits/0599c7d45a242519b6bdb63775bd07228c5f70d6","html_url":"https://github.com/gts360/django-mcp-server/commit/0599c7d45a242519b6bdb63775bd07228c5f70d6"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24852657266,"node_id":"HRFPE_lADOOns7hc8AAAABAdJZ888AAAAFyVV0cg","url":"https://api.github.com/repos/gts360/django-mcp-server/issues/events/24852657266","actor":{"login":"gghez","id":6266247,"node_id":"MDQ6VXNlcjYyNjYyNDc=","avatar_url":"https://avatars.githubusercontent.com/u/6266247?v=4","gravatar_id":"","url":"https://api.github.com/users/gghez","html_url":"https://github.com/gghez","followers_url":"https://api.github.c